# Environment configuration for the Order Intake & Fulfillment agent.

# Google Gemini API key (never committed; provisioned as a Cloud Run secret).
GOOGLE_API_KEY=

# Gemini model id used inside the ADK agent.
GEMINI_MODEL=gemini-3.5-flash

# Application name — also the ADK app name that scopes durable sessions.
APP_NAME=valence

# Session persistence backend for the running service:
#   firestore  -> google.adk FirestoreSessionService (production / emulator)
#   memory     -> in-memory (fast local debugging; sessions are lost on restart)
SESSION_SERVICE=firestore

# Firestore session root collection (only relevant when SESSION_SERVICE=firestore).
ADK_FIRESTORE_ROOT_COLLECTION=adk-session

# Meta Cloud API WhatsApp credentials (issue #13) — the live WhatsApp channel.
# META_APP_SECRET verifies the X-Hub-Signature-256 on inbound webhook POSTs;
# META_VERIFY_TOKEN answers the GET verification handshake; META_ACCESS_TOKEN
# (permanent) sends outbound replies and fetches inbound media ids via the
# Graph API; META_PHONE_NUMBER_ID targets the test number's /messages endpoint.
# All fail closed when unset (handshake/signature never verify; no send).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Security-gated surfaces (issue #27 / #28): no public defaults.
# The /api/roundtrip probe is closed (503) unless a bearer token is configured.
ROUNDTRIP_TOKEN=
# The /api/voice/ingest endpoint (issue #35) is closed (503) unless a bearer
# token is configured. The caller on that path is trusted company metadata
# (never caller-ID), so the token is the only way in.
VOICE_INGEST_TOKEN=
# Review web view passcode + per-deploy salt (cookie digest is HMAC-salted).
WEB_PASSCODE=
WEB_PASSCODE_SALT=

# Cloud Storage bucket holding Tally voucher XML (issue #8). Leave empty to use
# the in-memory store (voucher still downloadable for the manual import path,
# but lost on restart); provisioned as "valence-<project>-vouchers" by infra.
VOUCHER_BUCKET=

# WhatsApp webhook quota: max agent turns per sender per minute (security #32).
# Enforced by an in-memory, per-instance limiter; over-limit batches get 429.
WEBHOOK_RATE_LIMIT_PER_SENDER=30
