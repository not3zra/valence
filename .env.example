# Environment configuration for the Order Intake & Fulfillment agent.

# Google Gemini API key (never committed; provisioned as a Cloud Run secret).
GOOGLE_API_KEY=

# Model provider selected inside the ADK agent (issue #53, ADR-0008):
#   gemini  -> native Gemini via ADK's built-in adapter (default; no LiteLLM)
#   fake    -> local echo provider for tests and offline runs
MODEL_PROVIDER=gemini

# Gemini model id used when MODEL_PROVIDER=gemini.
GEMINI_MODEL=gemini-3.5-flash

# Application name — also the ADK app name that scopes durable sessions.
APP_NAME=valence

# Persistence backend for sessions and orders:
#   memory     -> in-memory (default; no GCP required, lost on restart)
#   sqlite     -> durable, GCP-free local boot on DATABASE_URL
#   postgres   -> Postgres on a postgresql+asyncpg:// DATABASE_URL (Compose)
#   firestore  -> Firestore via the optional [gcp] extra (production / emulator)
SESSION_SERVICE=memory

# Order store selected by the composition root. Leave empty to follow
# SESSION_SERVICE (memory, or Firestore when the durable session is selected):
#   memory     -> in-memory (default; no GCP required, lost on restart)
#   sqlite     -> durable, GCP-free local boot on DATABASE_URL
#   postgres   -> Postgres on a postgresql+asyncpg:// DATABASE_URL (Compose)
#   firestore  -> Firestore via the optional [gcp] extra
ORDER_STORE=

# SQLAlchemy async URL for the SQL store and sessions. A fresh SQLite file boots
# with the sample catalog; orders, events, and sessions survive a restart. The
# Compose profile composes a postgresql+asyncpg:// URL from POSTGRES_PASSWORD.
DATABASE_URL=sqlite+aiosqlite:///./valence.db

# One-time bootstrap token for POST /api/v1/setup. Leave unset after
# `valence init` has issued the first admin key; the endpoint disables itself
# as soon as an admin key exists. Generate a strong secret and never commit it.
VALENCE_SETUP_TOKEN=

# Required by the Docker Compose profile: Postgres password for the valence
# user. The app's DATABASE_URL is composed from this value by docker-compose.yml.
# Use URL-safe characters only (no @ / : # %), generate a strong value, and
# never commit it.
POSTGRES_PASSWORD=

# Firestore session root collection (only relevant when SESSION_SERVICE=firestore).
ADK_FIRESTORE_ROOT_COLLECTION=adk-session

# Meta Cloud API WhatsApp credentials (issue #13) — the live WhatsApp channel.
# META_APP_SECRET verifies the X-Hub-Signature-256 on inbound webhook POSTs;
# META_VERIFY_TOKEN answers the GET verification handshake; META_ACCESS_TOKEN
# (permanent) sends outbound replies and fetches inbound media ids via the
# Graph API; META_PHONE_NUMBER_ID targets the test number's /messages endpoint.
# All fail closed when unset (handshake/signature never verify; no send).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Security-gated surfaces (issue #27 / #28): no public defaults.
# The /api/roundtrip probe is closed (503) unless a bearer token is configured.
ROUNDTRIP_TOKEN=
# The /api/voice/ingest endpoint (issue #35) is closed (503) unless a bearer
# token is configured. The caller on that path is trusted company metadata
# (never caller-ID), so the token is the only way in.
VOICE_INGEST_TOKEN=
# Review web view passcode + per-deploy salt (cookie digest is HMAC-salted).
WEB_PASSCODE=
WEB_PASSCODE_SALT=
# Set to 0 only for plain-HTTP local Compose runs; secure cookies need HTTPS.
WEB_COOKIE_SECURE=1

# Cloud Storage bucket holding Tally voucher XML (issue #8). Leave empty to use
# the in-memory store (voucher still downloadable for the manual import path,
# but lost on restart); requires the optional [gcp] extra when set.
VOUCHER_BUCKET=

# Local filesystem directory for prepared Tally voucher XML (issue #55). Used
# when VOUCHER_BUCKET is empty; one XML file per voucher, kept across restarts
# and downloadable from the review view. Leave empty for the in-memory store.
VOUCHER_DIR=

# WhatsApp webhook quota: max agent turns per sender per minute (security #32).
# Enforced by an in-memory, per-instance limiter; over-limit batches get 429.
WEBHOOK_RATE_LIMIT_PER_SENDER=30
